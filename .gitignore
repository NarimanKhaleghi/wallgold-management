# dependencies
node_modules/

# package-manager lockfiles other than npm break Cloudflare Workers Builds
# (Cloudflare auto-detects bun.lock/yarn.lock/pnpm-lock.yaml and installs with
#  the wrong tool — the project officially supports npm + package-lock.json only)
bun.lock
bun.lockb
yarn.lock
pnpm-lock.yaml

# build output
dist/
.vite/

# wrangler
.wrangler/
.dev.vars
.dev.vars.*

# logs
*.log
npm-debug.log*
dev.log
server.log
wrangler-debug.log

# env
.env
.env.*

# misc
.DS_Store
Thumbs.db
*.pem

# editor
.vscode/
.idea/
